# deploy/docker-compose.yml 用的环境变量。复制为 deploy/.env 并填写。
# MUST NOT 提交真实值。生成密钥：openssl rand -base64 32

# ── PostgreSQL ──
DATABASE_NAME=newsportal
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=

# ── Strapi 密钥 ──
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# ── Strapi 对外地址 ──
# 反代 + TLS 后的公开 URL，配合 apps/cms/config/server.ts 的 url/proxy。
# 留空则 compose 回退到 https://cms.sibian.xyz。
URL=https://cms.example.com

# ── CORS（MUST 锁定前台域名）──
CORS_ORIGINS=https://example.com

# ── 发布联动（指向前台）──
WEB_REVALIDATE_URL=https://example.com/api/revalidate
WEB_REVALIDATE_TOKEN=

# ── 友链埋点共享密钥 ──
# MUST 与 apps/web/.env.local 的 FRIEND_TRACK_SECRET 完全一致，否则前台埋点被 Strapi 拒绝。
FRIEND_TRACK_SECRET=

# ── R2 媒体（可选）──
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_URL=

# ─────────────────────────────────────────────────────────────
# 以下是人工运维用的 Cloudflare 凭证，docker-compose.yml 不读取。
# 放这里只是集中保管；改 DNS / WAF / R2 时手动 source 后 curl CF API 用。
# 复制到新项目时按需保留。
# ─────────────────────────────────────────────────────────────
# Global API Key 走 X-Auth-Email + X-Auth-Key 认证（权限极大，慎用）
CF_AUTH_EMAIL=
CF_GLOBAL_API_KEY=
# 细粒度 API Token：R2 存储桶管理
CF_R2_ADMIN_TOKEN=
# 细粒度 API Token：Zone 级 WAF 规则（防盗链规则含搜索引擎白名单）
CF_ZONE_WAF_TOKEN=
