# deploy/docker-compose.yml 用的环境变量。复制为 deploy/.env 并填写。
# MUST NOT 提交真实值。生成密钥：openssl rand -base64 32

# ── PostgreSQL ──
DATABASE_NAME=newsportal
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=

# ── Strapi 密钥 ──
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# ── CORS（MUST 锁定前台域名）──
CORS_ORIGINS=https://example.com

# ── 发布联动（指向 Cloudflare 上的前台）──
WEB_REVALIDATE_URL=https://example.com/api/revalidate
WEB_REVALIDATE_TOKEN=

# ── R2 媒体（可选）──
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_URL=
