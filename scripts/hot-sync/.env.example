# 热榜同步二创脚本 — 环境变量模板（复制为 .env 并填值）
STRAPI_API_URL=http://127.0.0.1:1337
STRAPI_API_TOKEN=          # Strapi 后台 Settings → API Tokens 创建（article: create/find, channel: find, tag: find/create, author: find, sensitive-word: find）

# 自动发布：1=生成即发布(命中敏感词者仍留草稿)；0=全部留草稿人工审核（--draft 参数同效）
AUTO_PUBLISH=1

# 生成后端：claude(默认，走本机 Claude Code Max 订阅登录态) | minimax | wujiai
GEN_BACKEND=claude
CLAUDE_MODEL=sonnet        # claude -p 的 --model

# 注意：MUST NOT 在此配置 ANTHROPIC_API_KEY。
# index.mjs / repair.mjs / backfill-tags.mjs 调用 claude 子进程时都显式传
# ANTHROPIC_API_KEY:''，强制走订阅登录态；配了也会被置空，只会让人误以为在按 API 计费。

# MiniMax（可选；国际站，需账户有余额）
MINIMAX_API_URL=https://api.minimax.io/v1
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7

# 无极AI（可选；OpenAI 兼容 vLLM）
WUJIAI_API_URL=https://chat.wujiai.cloud/api/v1
WUJIAI_API_KEY=
WUJIAI_MODEL=无极AI

# 热榜聚合 API（60s 项目实例，逗号分隔按序回退；百度/头条/抖音/知乎优先直连官方接口，微博只走这里）
# 官方实例 60s-api.viki.moe 自 2026-08-21 起对本机 IP 403，公共镜像放前面
HOT_API_BASE=https://60s.okbaike.com/v2,https://60s-api.viki.moe/v2
