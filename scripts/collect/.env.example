# Collection workbench runtime secrets — copy to .env (chmod 600). .env is gitignored; never commit it.
# The admin (collect-config) stores only these variable NAMES, never the values.

# Strapi REST token for the collection pipeline (its own token, separate from hot-sync)
COLLECT_STRAPI_API_URL=http://127.0.0.1:1337
COLLECT_STRAPI_API_TOKEN=

# Provider: OpenAI-compatible endpoint (base URL without /chat/completions)
COLLECT_WUJIAI_BASE_URL=https://chat.wujiai.cloud/api
COLLECT_WUJIAI_MODEL=无极AI
COLLECT_WUJIAI_API_KEY=
