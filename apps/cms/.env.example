# ───────── Strapi 5 CMS — 复制为 apps/cms/.env ─────────
# MUST NOT 提交真实密钥（§1 / §9）。生成随机值：openssl rand -base64 32

HOST=0.0.0.0
PORT=1337

# 密钥（部署前 MUST 全部替换为随机值）
APP_KEYS=key1ReplaceMe,key2ReplaceMe
API_TOKEN_SALT=replaceMeApiTokenSalt
ADMIN_JWT_SECRET=replaceMeAdminJwtSecret
TRANSFER_TOKEN_SALT=replaceMeTransferTokenSalt
JWT_SECRET=replaceMeJwtSecret
ENCRYPTION_KEY=replaceMeEncryptionKey

# ───────── 数据库：PostgreSQL 16+（MUST，禁止 SQLite 上生产 §1）─────────
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=newsportal
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_SCHEMA=public
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ───────── CORS：MUST 锁定到前台域名，禁止 *（§7）─────────
CORS_ORIGINS=http://localhost:3000

# ───────── 发布联动（M3/M5）：前台按需 ISR 接口 ─────────
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
WEB_REVALIDATE_TOKEN=changeme-shared-with-web

# ───────── 媒体存储 R2（SHOULD，M5 启用）─────────
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=
# R2_BUCKET=
# R2_PUBLIC_URL=
