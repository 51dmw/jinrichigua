# ───────── Next.js 15 前台 — 复制为 apps/web/.env.local ─────────

# 站点公开地址（canonical / sitemap / OG MUST 用绝对地址，§4）
SITE_URL=http://localhost:3000

# Strapi API 地址（前台只读「已发布」内容，§2）
STRAPI_API_URL=http://localhost:1337

# 可选：若 Strapi 收紧了 public 权限，用 API Token 读取
# STRAPI_API_TOKEN=

# 友链埋点共享密钥（友链统计第1期）。服务端调用 Strapi /api/friend-link/track 带此头校验。
# MUST 与 apps/cms 的 FRIEND_TRACK_SECRET 完全一致；留空则前台不发埋点（开发环境）。
FRIEND_TRACK_SECRET=changeme-shared-with-web-friend-track

# 按需 ISR：与 Strapi 的 WEB_REVALIDATE_TOKEN MUST 一致（§5）
REVALIDATE_TOKEN=changeme-shared-with-web

# ISR 重新验证间隔（秒，60–300，§5）
REVALIDATE_SECONDS=120

# IndexNow 密钥（§4：Yandex + Bing 即时收录）。
# 生成：openssl rand -hex 16。会暴露在 /indexnow-key.txt 供校验。留空则不推送。
INDEXNOW_KEY=

# 站点主语言（§4 hreflang）
SITE_LOCALE=zh-CN

# GA4 衡量 ID（形如 G-XXXXXXXXXX）。留空则不注入 gtag.js。
# Yandex Metrica 的 ID 不在这里 —— 它由 Strapi 站点设置的 yandexMetricaId 字段驱动。
NEXT_PUBLIC_GA_ID=

# Cloudflare Turnstile 无感人机验证（§1 评论防刷）。两者都留空则跳过验证。
# 控制台领取正式密钥；本地联调可用官方测试密钥（恒通过）：
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 广告位占位图模式（§M6 预览/验收）：=1 时全站无创意广告位渲染占位框。生产留空/0。
ADS_PLACEHOLDER=
